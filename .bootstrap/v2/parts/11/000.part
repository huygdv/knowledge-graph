{"version":1,"id":"profile.backend-engineer","title":"Backend Engineer Capability Profile","description":"Career lens from Fresher to Lead. Levels describe expected outcomes and depth, not intrinsic difficulty of a knowledge node.","role":"Backend Engineer","levels":[{"key":"fresher","rank":1,"title":"Fresher","outcome":"Can implement small changes with guidance and explain foundational concepts.","requirements":[{"nodeId":"concept.data-structures","expectedMastery":2,"importance":"core","outcome":"Use basic collections and explain simple trade-offs."},{"nodeId":"concept.complexity","expectedMastery":1,"importance":"core","outcome":"Recognize obvious performance differences."},{"nodeId":"tool.php","expectedMastery":2,"importance":"core","outcome":"Read and write basic PHP safely."},{"nodeId":"tool.laravel","expectedMastery":2,"importance":"core","outcome":"Implement routing, validation and CRUD with guidance."},{"nodeId":"concept.http-semantics","expectedMastery":2,"importance":"core","outcome":"Use common methods and status codes correctly."},{"nodeId":"concept.api-contract","expectedMastery":2,"importance":"core","outcome":"Follow an existing request/response contract."},{"nodeId":"concept.relational-model","expectedMastery":2,"importance":"core","outcome":"Understand table, key and relation basics."},{"nodeId":"concept.sql","expectedMastery":2,"importance":"core","outcome":"Write basic SELECT, JOIN and aggregate queries."},{"nodeId":"tool.mysql","expectedMastery":2,"importance":"supporting","outcome":"Use the project database and migrations."},{"nodeId":"tool.docker","expectedMastery":1,"importance":"supporting","outcome":"Run the development environment."},{"nodeId":"concept.cicd","expectedMastery":1,"importance":"supporting","outcome":"Understand why checks run before deployment."},{"nodeId":"concept.code-review","expectedMastery":1,"importance":"supporting","outcome":"Respond to review feedback and explain changes."}]},{"key":"junior","rank":2,"title":"Junior","outcome":"Can deliver bounded backend features independently inside an existing architecture.","requirements":[{"nodeId":"concept.oop","expectedMastery":3,"importance":"core","outcome":"Design small classes with clear responsibilities."},{"nodeId":"tool.php","expectedMastery":3,"importance":"core","outcome":"Implement production code and handle common language pitfalls."},{"nodeId":"tool.laravel","expectedMastery":3,"importance":"core","outcome":"Build feature slices using framework conventions."},{"nodeId":"concept.api-contract","expectedMastery":3,"importance":"core","outcome":"Design a bounded endpoint contract."},{"nodeId":"concept.error-model","expectedMastery":3,"importance":"core","outcome":"Return consistent, actionable errors."},{"nodeId":"concept.authentication","expectedMastery":3,"importance":"core","outcome":"Implement an existing authentication approach."},{"nodeId":"concept.authorization","expectedMastery":3,"importance":"core","outcome":"Apply role or policy checks correctly."},{"nodeId":"concept.sql","expectedMastery":3,"importance":"core","outcome":"Write non-trivial queries and verify results."},{"nodeId":"concept.transactions","expectedMastery":3,"importance":"core","outcome":"Place a business operation inside a correct transaction boundary."},{"nodeId":"concept.indexing","expectedMastery":2,"importance":"supporting","outcome":"Recognize when an index may help."},{"nodeId":"concept.message-queue","expectedMastery":2,"importance":"supporting","outcome":"Publish and consume a background job safely."},{"nodeId":"concept.retry","expectedMastery":2,"importance":"supporting","outcome":"Handle transient failure without blind retry."},{"nodeId":"concept.logging","expectedMastery":3,"importance":"supporting","outcome":"Add structured logs for debugging."},{"nodeId":"tool.docker","expectedMastery":3,"importance":"supporting","outcome":"Debug containerized local services."},{"nodeId":"concept.cicd","expectedMastery":3,"importance":"supporting","outcome":"Fix common pipeline failures."}]},{"key":"middle","rank":3,"title":"Middle","outcome":"Can own a production feature from design through operation and diagnose common failures.","requirements":[{"nodeId":"concept.system-boundaries","expectedMastery":3,"importance":"core","outcome":"Choose reasonable module and service boundaries."},{"nodeId":"concept.api-contract","expectedMastery":4,"importance":"core","outcome":"Evolve contracts without breaking consumers."},{"nodeId":"technique.api-versioning","expectedMastery":3,"importance":"core","outcome":"Choose a practical compatibility strategy."},{"nodeId":"concept.idempotency","expectedMastery":4,"importance":"core","outcome":"Design retry-safe write operations."},{"nodeId":"concept.transactions","expectedMastery":4,"importance":"core","outcome":"Model consistency boundaries across a feature."},{"nodeId":"concept.isolation-levels","expectedMastery":3,"importance":"core","outcome":"Diagnose common concurrency anomalies."},{"nodeId":"concept.indexing","expectedMastery":4,"importance":"core","outcome":"Design composite indexes for real query patterns."},{"nodeId":"technique.execution-plan","expectedMastery":3,"importance":"core","outcome":"Read plans and locate common bottlenecks."},{"nodeId":"concept.query-optimization","expectedMastery":3,"importance":"core","outcome":"Improve query performance using evidence."},{"nodeId":"concept.delivery-semantics","expectedMastery":3,"importance":"core","outcome":"Design consumers for at-least-once delivery."},{"nodeId":"concept.dead-letter","expectedMastery":3,"importance":"supporting","outcome":"Operate and recover failed messages."},{"nodeId":"concept.caching","expectedMastery":3,"importance":"supporting","outcome":"Choose cache keys and invalidation rules."},{"nodeId":"concept.observability","expectedMastery":3,"importance":"core","outcome":"Use logs, metrics and traces to debug a feature."},{"nodeId":"concept.incident-response","expectedMastery":3,"importance":"supporting","outcome