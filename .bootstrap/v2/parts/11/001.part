":"Contribute effectively during incidents."},{"nodeId":"concept.secure-delivery","expectedMastery":3,"importance":"supporting","outcome":"Avoid common credential and permission mistakes."},{"nodeId":"concept.delivery-slicing","expectedMastery":3,"importance":"supporting","outcome":"Break work into reviewable production slices."}]},{"key":"senior","rank":4,"title":"Senior","outcome":"Can design and evolve production systems, lead diagnosis and raise engineering standards.","requirements":[{"nodeId":"concept.quality-attributes","expectedMastery":4,"importance":"core","outcome":"Turn non-functional needs into design constraints."},{"nodeId":"concept.tradeoffs","expectedMastery":5,"importance":"core","outcome":"Explain decisions in context and alternatives."},{"nodeId":"concept.system-design","expectedMastery":5,"importance":"core","outcome":"Design data flow, failure handling and operational model."},{"nodeId":"technique.adr","expectedMastery":4,"importance":"core","outcome":"Capture consequential technical decisions."},{"nodeId":"concept.evolutionary-architecture","expectedMastery":4,"importance":"core","outcome":"Plan safe migration paths and incremental change."},{"nodeId":"concept.api-contract","expectedMastery":5,"importance":"core","outcome":"Set API standards across multiple consumers."},{"nodeId":"concept.idempotency","expectedMastery":5,"importance":"core","outcome":"Design correctness under retries and partial failure."},{"nodeId":"concept.mvcc","expectedMastery":4,"importance":"supporting","outcome":"Diagnose database behavior under concurrency."},{"nodeId":"technique.execution-plan","expectedMastery":4,"importance":"core","outcome":"Diagnose complex query plans in production."},{"nodeId":"pattern.outbox","expectedMastery":4,"importance":"core","outcome":"Choose and implement reliable event publication."},{"nodeId":"concept.eventual-consistency","expectedMastery":4,"importance":"core","outcome":"Design user and system behavior during convergence."},{"nodeId