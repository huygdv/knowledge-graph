"title":"Quality Attributes","summary":"Reliability, security, performance, maintainability và cost.","tags":["architecture"]},{"id":"concept.system-boundaries","kind":"concept","title":"System Boundaries","summary":"Phân chia responsibility và dependency giữa component.","tags":["architecture"]},{"id":"concept.tradeoffs","kind":"concept","title":"Technical Trade-offs","summary":"Ra quyết định dựa trên context thay vì best practice tuyệt đối.","tags":["architecture"]},{"id":"technique.adr","kind":"technique","title":"Architecture Decision Record","summary":"Ghi context, decision, alternatives và consequences.","tags":["architecture"]},{"id":"concept.evolutionary-architecture","kind":"concept","title":"Evolutionary Architecture","summary":"Cho phép hệ thống thay đổi có kiểm soát theo feedback.","tags":["architecture"]},{"id":"concept.system-design","kind":"concept","title":"System Design","summary":"Kết hợp requirement, component, data flow và failure mode.","tags":["architecture"]},{"id":"concept.delivery-slicing","kind":"technique","title":"Delivery Slicing","summary":"Chia scope thành vertical slice tạo feedback sớm.","tags":["delivery"]},{"id":"concept.risk-management","kind":"concept","title":"Engineering Risk Management","summary":"Nhận diện, giảm thiểu và theo dõi risk kỹ thuật/delivery.","tags":["delivery"]},{"id":"concept.code-review","kind":"concept","title":"Code Review","summary":"Review correctness, maintainability, security và knowledge sharing.","tags":["quality"]},{"id":"concept.technical-debt","kind":"concept","title":"Technical Debt","summary":"Quản trị chi phí tương lai do shortcut và thay đổi context.","tags":["architecture"]},{"id":"concept.operating-review","kind":"concept","title":"Operating Review","summary":"Theo dõi outcome, reliability, blocker và quyết định tiếp theo.","tags":["management"]},{"id":"concept.mentoring","kind":"concept","title":"Mentoring","summary":"Truyền kinh nghiệm và định hướng phát triển dài hạn.","tags":["people"]},{"i