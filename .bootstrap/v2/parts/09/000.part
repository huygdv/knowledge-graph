{"version":2,"meta":{"id":"huygdv.personal-engineering-knowledge","title":"Personal Engineering Knowledge Graph","description":"Canonical knowledge library for engineering growth, evidence and mentorship.","principles":["Knowledge nodes describe the subject, not the learner.","Personal mastery lives in overlays.","Career expectations live in profiles.","Artifacts provide evidence of applied knowledge."]},"masteryScale":[{"value":0,"key":"unexplored","label":"Unexplored"},{"value":1,"key":"recognize","label":"Recognize"},{"value":2,"key":"understand","label":"Understand"},{"value":3,"key":"apply","label":"Apply"},{"value":4,"key":"diagnose","label":"Diagnose"},{"value":5,"key":"design","label":"Design"},{"value":6,"key":"teach","label":"Teach"}],"nodes":[{"id":"domain.backend","kind":"domain","title":"Backend Engineering","summary":"Thiết kế, xây dựng và vận hành hệ thống backend production.","tags":["backend","production"]},{"id":"domain.ai","kind":"domain","title":"AI Engineering","summary":"Xây dựng hệ thống LLM, retrieval, agent và evaluation có kiểm soát.","tags":["ai","agentic"]},{"id":"domain.leadership","kind":"domain","title":"Engineering Leadership","summary":"Kiến trúc, delivery, mentoring và phát triển năng lực đội ngũ.","tags":["leadership","management"]},{"id":"capability.programming","kind":"capability","title":"Programming Foundations","summary":"Nền tảng ngôn ngữ, cấu trúc dữ liệu, concurrency và tư duy hệ thống.","tags":["foundation"]},{"id":"capability.api","kind":"capability","title":"API Engineering","summary":"Thiết kế hợp đồng API ổn định, an toàn và có khả năng tiến hóa.","tags":["api"]},{"id":"capability.data","kind":"capability","title":"Data & Database Engineering","summary":"Mô hình dữ liệu, transaction, truy vấn và tối ưu database.","tags":["database"]},{"id":"capability.async","kind":"capability","title":"Async & Distributed Systems","summary":"Queue, event, retry, idempotency và consistency giữa dịch vụ.","tags":["distributed-systems"]},{"id":"capability.platform","kind":"capability","title":"Platform & Reliability","summary":"Container, cloud, CI/CD, observability và vận hành production.","tags":["platform","reliability"]},{"id":"concept.data-structures","kind":"concept","title":"Data Structures","summary":"Array, map, tree, graph và trade-off về độ phức tạp.","tags":["algorithms"]},{"id":"concept.complexity","kind":"concept","title":"Complexity Analysis","summary":"Đánh giá time/space complexity và giới hạn tăng trưởng.","tags":["algorithms"]},{"id":"concept.oop","kind":"concept","title":"Object-Oriented Design","summary":"Encapsulation, composition, polymorphism và responsibility.","tags":["design"]},{"id":"concept.functional-core","kind":"pattern","title":"Functional Core, Imperative Shell","summary":"Tách logic thuần khỏi side effect để dễ kiểm thử.","tags":["pattern"]},{"id":"concept.concurrency","kind":"concept","title":"Concurrency","summary":"Async, race condition, synchronization và coordination.","tags":["runtime"]},{"id":"tool.php","kind":"tool","title":"PHP","summary":"Ngôn ngữ backend chính trong hành trình nghề nghiệp.","tags":["language"]},{"id":"tool.laravel","kind":"tool","title":"Laravel","summary":"Framework backend với routing, ORM, queue và ecosystem.","tags":["framework"]},{"id":"tool.nodejs","kind":"tool","title":"Node.js","summary":"JavaScript runtime cho API và event-driven workload.","tags":["runtime"]},{"id":"tool.nestjs","kind":"tool","title":"NestJS","summary":"Framework Node.js có module, dependency injection và convention.","tags":["framework"]},{"id":"concept.api-contract","kind":"concept","title":"API Contract","summary":"Schema request/response, invariants và compatibility boundary.","tags":["api","contract"]},{"id":"concept.http-semantics","kind":"concept","title":"HTTP Semantics","summary":"Method, status code, cacheability và content negotiation.","tags":["http"]},{"id":"technique.api-versioning","kind":"technique","title":"API Versioning","summary":"Chiến lược thay đổi API mà không phá client cũ.","tags":["api"]},{"id":"concept.error-model","kind":"concept","title":"Error Model","summary":"Chuẩn hóa lỗi, error code, trace ID và thông tin có thể hành động.","tags":["api","reliability"]},{"id":"concept.idempotency","kind":"concept","title":"Idempotency","summary":"Đảm bảo retry không tạo hiệu ứng phụ lặp ngoài ý muốn.","tags":["reliability"]},{"id":"concept.authentication","kind":"concept","title":"Authentication","summary":"Xác minh danh tính qua session, token hoặc delegated identity.","tags":["security"]},{"id":"concept.authorization","kind":"concept","title":"Authorization","summary":"Kiểm soát quyền theo role, policy và resource context.","tags":["security"]},{"id":"technique.rate-limiting","kind":"technique","title":"Rate Limiting","summary":"Bảo vệ tài nguyên bằng quota, token bucket hoặc sliding window.","tags":["security","reliability"]},{"id":"pattern.api-gateway","kind":"pattern","title":"API Gateway","summary":"Điểm vào tập trung cho routing, policy và cross-cutting concern.","tags":["architecture"]},{"id":"concept.relational-model","kind":"concept","title":"Relational Model","summary":"Table, relation, key, constraint và normalization.","tags":["database"]},{"id":"concept.sql","kind":"concept","title":"SQL","summary":"Truy vấn tập hợp, join, aggregate và window function.","tags":["database","query"]},{"id":"tool.mysql","kind":"tool","title":"MySQL","summary":"RDBMS phổ biến trong hệ thống PHP và web application.","tags":["database"]},{"id":"tool.postgresql","kind":"tool","title":"PostgreSQL","summary":"RDBMS mạnh về correctness, extension và query capability.","tags":["database"]},{"id":"concept.transactions","kind":"concept","title":"Transactions","summary":"ACID, transaction boundary và atomic business operation.","tags":["database","correctness"]},{"id":"concept.isolation-levels","kind":"concept","title":"Isolation Levels","summary":"Read phenomena và trade-off giữa consistency với concurrency.","tags":["d