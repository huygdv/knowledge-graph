atabase","concurrency"]},{"id":"concept.mvcc","kind":"concept","title":"MVCC","summary":"Quản lý nhiều phiên bản row để hỗ trợ concurrent transaction.","tags":["postgresql","concurrency"]},{"id":"concept.indexing","kind":"concept","title":"Database Indexing","summary":"B-tree, composite index, selectivity và covering index.","tags":["database","performance"]},{"id":"technique.execution-plan","kind":"technique","title":"Execution Plan Analysis","summary":"Đọc EXPLAIN để hiểu access path, cost và bottleneck.","tags":["database","performance"]},{"id":"concept.query-optimization","kind":"concept","title":"Query Optimization","summary":"Tối ưu truy vấn dựa trên workload và query planner.","tags":["database","performance"]},{"id":"concept.schema-evolution","kind":"concept","title":"Schema Evolution","summary":"Thay đổi schema an toàn, backward compatible và có rollback.","tags":["database","migration"]},{"id":"tool.mongodb","kind":"tool","title":"MongoDB","summary":"Document database cho workload có cấu trúc document phù hợp.","tags":["database","document"]},{"id":"tool.redis","kind":"tool","title":"Redis","summary":"In-memory data store cho cache, lock và ephemeral state.","tags":["cache"]},{"id":"concept.caching","kind":"concept","title":"Caching","summary":"Giảm latency và tải hệ thống bằng dữ liệu tạm có chiến lược invalidation.","tags":["performance"]},{"id":"concept.message-queue","kind":"concept","title":"Message Queue","summary":"Tách producer/consumer và xử lý workload bất đồng bộ.","tags":["queue"]},{"id":"concept.event-driven","kind":"concept","title":"Event-Driven Architecture","summary":"Phối hợp hệ thống qua event và phản ứng theo thay đổi.","tags":["architecture"]},{"id":"concept.delivery-semantics","kind":"concept","title":"Delivery Semantics","summary":"At-most-once, at-least-once và exactly-once illusion.","tags":["distributed-systems"]},{"id":"concept.retry","kind":"concept","title":"Retry Strategy","summary":"Backoff, jitter, retry budget và phân loại lỗi có thể retry.","tags":["reliability"]},{"id":"concept.dead-letter","kind":"concept","title":"Dead-Letter Queue","summary":"Cô lập message thất bại để điều tra và xử lý lại.","tags":["queue","reliability"]},{"id":"pattern.outbox","kind":"pattern","title":"Transactional Outbox","summary":"Đồng bộ transaction database với việc publish event.","tags":["pattern","consistency"]},{"id":"concept.eventual-consistency","kind":"concept","title":"Eventual Consistency","summary":"Chấp nhận trạng thái tạm thời khác nhau và hội tụ về sau.","tags":["distributed-systems"]},{"id":"concept.distributed-lock","kind":"concept","title":"Distributed Lock","summary":"Điều phối truy cập tài nguyên giữa nhiều process hoặc node.","tags":["distributed-systems"]},{"id":"concept.saga","kind":"pattern","title":"Saga Pattern","summary":"Điều phối transaction dài bằng local transaction và compensation.","tags":["pattern"]},{"id":"tool.docker","kind":"tool","title":"Docker","summary":"Đóng gói ứng dụng và môi trường chạy nhất quán.","tags":["container"]},{"id":"concept.containerization","kind":"concept","title":"Containerization","summary":"Image, container, filesystem và process isolation.","tags":["container"]},{"id":"tool.aws","kind":"tool","title":"AWS","summary":"Cloud platform cho compute, database, storage và networking.","tags":["cloud"]},{"id":"concept.cicd","kind":"concept","title":"CI/CD","summary":"Tự động build, test, release và deploy có quality gate.","tags":["automation"]},{"id":"technique.infrastructure-as-code","kind":"technique","title":"Infrastructure as Code","summary":"Quản lý hạ tầng bằng code có version và review.","tags":["infra"]},{"id":"concept.observability","kind":"concept","title":"Observability","summary":"Suy luận trạng thái hệ thống từ logs, metrics và traces.","tags":["reliability"]},{"id":"concept.logging","kind":"concept","title":"Structured Logging","summary":"Log có cấu trúc, correlation ID và context để điều tra.","tags":["observability"]},{"id":"concept.metrics","kind":"concept","title":"Metrics","summary":"Đo sức khỏe và hành vi hệ thống theo time series.","tags":["observability"]},{"id":"concept.tracing","kind":"concept","title":"Distributed Tracing","summary":"Theo dõi request xuyên qua service và dependency.","tags":["observability"]},{"id":"concept.slo","kind":"concept","title":"SLO & Error Budget","summary":"Định lượng reliability mục tiêu và ngân sách lỗi.","tags":["reliability"]},{"id":"concept.incident-response","kind":"concept","title":"Incident Response","summary":"Phát hiện, giảm thiểu, phục hồi và học từ sự cố.","tags":["operations"]},{"id":"concept.secure-delivery","kind":"concept","title":"Secure Delivery","summary":"Secret management, least privilege và kiểm soát supply chain.","tags":["security"]},{"id":"capability.llm","kind":"capability","title":"LLM Foundations","summary":"Cách model xử lý token, context, inference và giới hạn.","tags":["llm"]},{"id":"capability.retrieval","kind":"capability","title":"Retrieval Systems","summary":"Embedding, search, ranking và grounded generation.","tags":["retrieval"]},{"id":"capability.agents","kind":"capability","title":"Agent Systems","summary":"Loop, tool use, state, planning và orchestration.","tags":["agentic"]},{"id":"capability.ai-quality","kind":"capability","title":"AI Quality & Safety","summary":"Evaluation, trace, regression, security và policy.","tags":["evaluation","safety"]},{"id":"capability.knowledge","kind":"capability","title":"Knowledge & Causal Systems","summary":"Knowledge graph, ontology, temporal và causal reasoning.","tags":["graph","causal"]},{"id":"concept.tokens","kind":"concept","title":"Tokens","summary":"Đơn vị biểu diễn đầu vào và đầu ra của language model.","tags":["llm"]},{"id":"concept.context-window","kind":"concept","title":"Context Window","summary":"Không gian thông tin model có thể tham chiếu trong một lần chạy.","tags":["llm","context"]},{"id":"concept.prompt-design","kind":"technique","title":"Prompt Design","summary":"Địn